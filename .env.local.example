# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Required for the contact form to actually send email.
# Get a key from https://resend.com after creating an account.
RESEND_API_KEY=

# Optional overrides — sensible defaults are used if omitted.
# Use "ARGG Associates <no-reply@argg.in>" once argg.in is verified in Resend.
CONTACT_FROM_EMAIL="ARGG Associates <onboarding@resend.dev>"
CONTACT_TO_EMAIL=support@argg.in

# Google reCAPTCHA v3 (invisible) — protects all enquiry forms from spam.
# Get keys from https://www.google.com/recaptcha/admin (register a v3 site).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
